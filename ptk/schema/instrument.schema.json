      "mixed",
      "unstated"
     ]
    },
    "cost_free_language": {
     "type": [
      "string",
      "null"
     ]
    },
    "bonus_recital": {
     "type": [
      "string",
      "null"
     ]
    },
    "delay_rental": {
     "type": [
      "string",
      "null"
     ]
    },
    "shut_in": {
     "type": [
      "string",
      "null"
     ]
    },
    "cessation_days": {
     "type": [
      "string",
      "null"
     ]
    },
    "continuous_development": {
     "type": [
      "string",
      "null"
     ]
    },
    "pugh_clause": {
     "type": "string",
     "enum": [
      "none",
      "vertical",
      "horizontal",
      "both",
      "unclear"
     ]
    },
    "depth_limitation": {
     "$ref": "#/$defs/depth"
    },
    "retained_acreage": {
     "type": [
      "string",
      "null"
     ]
    },
    "pooling": {
     "type": [
      "string",
